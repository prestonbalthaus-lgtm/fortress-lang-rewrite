(* ELISION IS AN ABSTRACT-DECLARATION FEATURE. `functions.tex:384-385` licenses
   an elided NAME only where there is no body.

   THE SHAPE IS WHAT MAKES THIS THE ELISION CASE AND NOT `baduntypedparam.fss`.
   `List[\ZZ32\]` is not a `BindId`, so nothing can read it as a parameter
   NAME -- this declaration really is eliding one, and really is refused by
   `functions.tex:384-385`. A bare identifier is the ambiguous shape and it
   goes the other way. *)

f(List[\ZZ32\]) = 2

run(): () = println(f(1))
