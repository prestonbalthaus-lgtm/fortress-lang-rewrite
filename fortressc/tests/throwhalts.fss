export Executable

trait Exception end

object NotFound(why: ZZ32) extends Exception end

made(k: ZZ32): NotFound = do
    println("OPERAND RAN")
    NotFound(k)
end

pick(x: ZZ32): ZZ32 = if x > 0 then x else throw made(x) end

run(): () = do
    println(pick(7))
    println(pick(0))
    println(999)
end
