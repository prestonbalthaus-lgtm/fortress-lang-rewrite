component implicitbuiltin
export Executable

(* THE COMPONENT HALF IS ARCHITECTURALLY OUT and this is the fixture that says
   so. A merged OBJECT takes a 32-bit type tag, which shifts every dispatch
   table built after it, and a merged SINGLETON is CONSTRUCTED in `main`. So
   `RR32` is still unknown here. *)
narrow(x: RR64): RR32 = 0.0

run(): () = println(1)

end
