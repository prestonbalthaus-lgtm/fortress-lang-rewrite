component implicitbuiltin
export Executable

(* THE COMPONENT HALF IS IN, AND IT IS TYPES ONLY. `RR32` and `Maybe` come from
   the core apis with no written import, and the BUILTIN still wins its own
   name: the literal, the string and `println` below all type against the
   compiler's `ZZ32`/`String`, not against the library's declarations of them. *)
widen32(x: RR32): RR64 = 0.0

hold(m: Maybe[\ZZ32\]): ZZ32 = 1

count(n: ZZ32, s: String): ZZ32 = n

run(): () = do
    println(count(7, "ok"))
    println("still a " || "String")
end

end
