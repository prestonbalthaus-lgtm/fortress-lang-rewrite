component selfgetter
export Executable

(* The getter half is IMPLEMENTED now: `size` is read as `x.size` and dispatched
   as a nullary dotted method. `x.size()` is refused -- a getter is read, never
   called.

   The `self` half is no longer only parsed. `area(self, k: ZZ32)` is a
   FUNCTIONAL method, lifted into the top-level overload set of `area` with the
   receiver in the position the source wrote it. It has no body, so it is a
   member of the set that can never be a dispatch target -- which is what makes
   an unimplemented one fail the exactly-one-winner check rather than need a
   rule of its own. *)
trait Shape
   getter size(): ZZ32
   area(self, k: ZZ32): ZZ32
end

run(): () = ()
end
