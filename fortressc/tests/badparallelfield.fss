component badparallelfield

export Executable

(* A field has no index, so there is no `a[i]` rule that makes two iterations
   disjoint. Every iteration would write the same four bytes. *)
object Box()
    var n: ZZ64 = 0
end

run(): () = do
    b = Box()
    for i <- 0#10 do
        b.n := i
    end
    println(b.n)
end
end
