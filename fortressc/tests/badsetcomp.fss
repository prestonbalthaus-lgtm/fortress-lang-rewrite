component badsetcomp
export Executable

(* THE ELEMENT TYPE IS WRITTEN, NEVER INFERRED, and a SET comprehension is held
   to that the same way the list form is. This fixture asserted "only the list
   form is implemented" until the set form was built; the invariant MOVED
   rather than went away, and this is what is left of it. It is also the exact
   wall the two `SpecData` set-comprehension examples now stop on. *)
run(): () = do
  s = { x | x <- 1:3 }
  println(1)
end
end
