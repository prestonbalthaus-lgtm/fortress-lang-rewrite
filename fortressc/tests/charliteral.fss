component charliteral
export Executable

(* EVERY SHAPE `lexical-structure.tex:862-877` ACCEPTS, and each of the last two
   lines CROSS-CHECKS one against another: a hex code point and the character it
   names must compare equal, and so must an escape and its spelled name. A
   decoder that got one path wrong and the other right would still print
   plausible characters on its own. *)

run(): () = do
    println('a')
    println(''')
    println('01C7')
    println('1D11E')
    println('TAB' = '\t')
    println('NEWLINE' = '\n')
    println('RETURN' = '\r')
    println('0061' = 'a')
    println(if 'a' < 'b' then "ordered" else "UNORDERED" end)
    println(if 'c' >= 'c' then "reflexive" else "NOT" end)
    println("concatenated: " 'z')
end
end
