component mapliteral
export Executable

(* A LATER KEY REPLACES AN EARLIER ONE, which is what makes this a map and not
   a multimap: three entries written, two keys, and `m[1]` is the SECOND value
   given for key 1. An exit code sees none of that. *)
run(): () = do
  m = {[\ZZ32,ZZ32\] 1 |-> 4, 2 |-> 8, 1 |-> 9}
  println(m.size())
  println(m[1])
  println(m[2])
  (* the two static arguments taken off the SLOT rather than the brackets *)
  n: Map[\ZZ64,ZZ64\] = {5 |-> 6}
  println(n.size())
  println(n[5])
  (* a map COMPREHENSION over a range *)
  c = {[\ZZ64,ZZ64\] x |-> 2 x | x <- 1:3}
  println(c.size())
  println(c[1])
  println(c[3])
  (* THE SAME BRACKETS STILL BUILD A SET when the element is not a mapping *)
  s = {[\ZZ64\] 7, 7, 3}
  println(s.size())
end
end
