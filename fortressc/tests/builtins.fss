component builtins
export Executable

(* `print` is `println` without the newline, `ignore` evaluates and discards,
   and `assert` is an `if` and a halt -- so it is exactly as strong as `=` is
   and no stronger. `side` printing is what shows `ignore` evaluated it. *)
side(): ZZ32 = do
   println("SIDE")
   7
end

run(): () = do
   print("a")
   print("b")
   print(1)
   print(true)
   println("")
   ignore(side())
   assert(true)
   assert(1 < 2, "one is less than two")
   assert(3, 3)
   assert(2 + 2, 4, "arithmetic still works")
   println("done")
end
end
