component badtupleexpr
export Executable

(* `x = (1, 2)` is FLATTENED as of 2026-08-23 -- two bindings and no tuple --
   so the binding is fine and it is the USE that is refused. `println` has no
   two-argument declaration for the parts to reach, so the tuple is written
   back out and refused for what it is. *)
run(): () = do
  x = (1, 2)
  println(x)
end

end
