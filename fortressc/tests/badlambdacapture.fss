component badlambdacapture

export Executable

(* A capture becomes a constructor parameter and a constructor parameter needs
   a written type. `k = 10` has none, so there is nothing to declare it with --
   and inventing one is how a wrong type gets in. *)
apply1(f: ZZ32 -> ZZ32, x: ZZ32): ZZ32 = f(x)

run(): () = do
    k = 10
    println(apply1(fn (x: ZZ32): ZZ32 => x + k, 5))
end
end
