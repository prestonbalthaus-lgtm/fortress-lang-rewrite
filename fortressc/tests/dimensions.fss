component dimensions
export Executable

dim Length SI_unit meter meters m_
dim Time SI_unit second seconds s_
dim Mass
dim Area = Length^2
dim Volume = Length^3
dim Velocity = Length / Time
dim Acceleration = Velocity per Time
dim Angle = Unity
dim Frequency = 1 / Time

unit inch inches: Length
unit foot feet: Length = 12 inches
unit meter_squared: Area = square meter

trait Quantity[\unit U absorbs unit, nat e\] end

(* THE TWO FEATURES IN ONE FILE. `Length^2` above is a dimension EXPONENT and
   `ZZ32[5]` here is an array SIZE, and both spellings run through the same
   suffix production -- one node at parse time, classified by the position it
   was written in, which is how the reference implementation reads it too. *)
g[\nat n\](a: ZZ32[n]): ZZ32 = a[0]

run() = do
  a: ZZ32[5] = [0 1 2 3 4]
  v: RR64[2] = [1.5 2.5]
  println(a[4])
  println(v[1])
  println(g[\3\]([7 8 9]))
  println("dimensions declared")
end

end
