component comprehensionmerged
import List.{...}
import Set.{...}
export Executable

(* A MERGED DECLARATION LOSES TO THE MINTED COLLECTION, which is Link 5's rule
   1 one level down. Both imports bring in a `List` and a `Set` an api
   DECLARES and never DEFINES -- `MergedObjectNotConstructible`, so neither
   was ever writable -- and the minted ones replace them. Refusing instead is
   what took `Test3.fss`, `FunctionalMethodAsUnifyParam.fss` and
   `importBig.fss` down. *)
run(): () = do
  l = <|[\ZZ64\] x | x <- 1:3 |>
  println(l.size())
  s = {[\ZZ64\] 7 | x <- 1:3}
  println(s.size())
end
end
