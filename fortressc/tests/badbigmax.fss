component badbigmax

export Executable

(* A BIG reduction over a COLLECTION rather than a range. `SUM`, `PROD`, `MAX`
   and `MIN` are all lowered onto the M5 accumulator when the generator is a
   range; iterating a collection needs the generator PROTOCOL, which needs a
   name to cross a file boundary first. Refused by name rather than read as a
   subscript, which is what it was. *)
run(): () = do
    a: Array[\ZZ64\] = array(4)
    println(SUM[x <- a] x)
end
end
